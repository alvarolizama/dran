# =============================================================================
# Dran — local environment template
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env
#
# Local dev: load it with `direnv allow` (or your shell's dotenv loader).
# Production: the deploy platform (Coolify, Fly, Render, etc.) injects
# these directly into the container — do NOT bake them into a Dockerfile.
# =============================================================================


# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# Phoenix runtime port. Most platforms inject $PORT automatically.
PORT=4000

# Public host the endpoint advertises. Used for URL generation and HSTS.
# Bare hostname only — no scheme, no port. If you serve over a non-standard
# port, set PHX_PORT to the external port.
# Local dev:   PHX_HOST=localhost
# LAN/VPN:     PHX_HOST=local-apps.vpn.cloud
# Public:      PHX_HOST=dran.example.com
PHX_HOST=localhost

# External port used in generated URLs (e.g. login redirects). Defaults to
# 443. Override when running behind a non-standard port or in dev.
# Local dev: 4000, LAN/VPN: 5000, public: 443
PHX_PORT=443

# URL scheme used in generated URLs. Defaults to https. Set to http when
# serving the app over plain HTTP (e.g. behind a NetBird / Wireguard
# tunnel without a TLS terminator in front).
PHX_SCHEME=https

# Set to 1 at BUILD time (not runtime) to disable Plug.SSL force_ssl.
# Required when serving the app over plain HTTP — otherwise Plug.SSL
# will redirect every request to https:// and clients will hang.
# In Coolify/Railpack this goes in the build env vars, not the runtime ones.
# DISABLE_FORCE_SSL=0

# Long random string used to sign/encrypt cookies and other secrets.
# Generate with:  mix phx.gen.secret
# Local dev: any 64+ char string is fine.
SECRET_KEY_BASE=replace-me-with-output-of-mix-phx-gen-secret

# Ecto connection URL.
# Local dev:   ecto://postgres:postgres@localhost/dran_dev
# Production:  postgres://dran:<DB_PASSWORD>@<DB_HOST>/dran_prod
DATABASE_URL=ecto://postgres:postgres@localhost/dran_dev

# Repo connection pool size. Default 10 is fine for most workloads.
# Bump it if you see "connection pool timeout" errors under load.
POOL_SIZE=10

# Set to "true" or "1" to force IPv6 for the database socket.
ECTO_IPV6=false


# -----------------------------------------------------------------------------
# Dran-specific
# -----------------------------------------------------------------------------

# Default credentials seeded on first run AND used by the HTTP API / MCP
# server. CHANGE THESE IN PRODUCTION — the dev defaults shown here are
# only safe for local development. The seed step reads these values
# and uses them to create the initial admin user / API token.
DRAN_USERNAME=admin
DRAN_PASSWORD=dran
DRAN_API_TOKEN=dran-token

# Default context created on first seed. The slug is the URL-safe identifier;
# the name is the human-readable label.
DRAN_CONTEXT_SLUG=personal
DRAN_CONTEXT_NAME=Personal


# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------

# Path where uploaded files are stored. Relative to the release root, or
# absolute. In production mount a persistent volume here (Coolify volume,
# Fly volume, S3-fuse, etc.) or set UPLOADS_DIR to point at one.
UPLOADS_DIR=priv/static/uploads

# Max upload size in bytes. Default 104857600 = 100 MiB.
UPLOADS_MAX_SIZE=104857600


# -----------------------------------------------------------------------------
# Inference API
# -----------------------------------------------------------------------------

# Base URL for the inference API. No trailing slash.
# Example local/OpenAI-compatible: http://<embedding-host>:8000/v1
DRAN_INFERENCE_API_URL=

# API key for the inference API. Keep secret.
# DRAN_INFERENCE_API_KEY=


# -----------------------------------------------------------------------------
# Cluster / distribution (optional)
# -----------------------------------------------------------------------------

# Set to a libcluster-compatible query (e.g. `dran.service.consul`) to enable
# distributed Erlang between release nodes. Leave unset for a single instance.
# DNS_CLUSTER_QUERY=
