<!DOCTYPE html>
<html lang="es" data-theme="night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Dran" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <div
      :if={assigns[:impersonator]}
      class="flex items-center justify-between gap-4 px-4 py-2 bg-warning/20 border-b border-warning/30"
    >
      <span class="text-sm font-medium">
        <.icon name="hero-user" class="size-4 inline-block mr-1.5 -mt-0.5" />
        {gettext("Estás impersonando a")} {assigns[:current_user]}
      </span>
      <form action={~p"/admin/impersonate"} method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <input type="hidden" name="_method" value="delete" />
        <button
          type="submit"
          class="btn btn-xs btn-error gap-1"
          title={gettext("Stop impersonating")}
        >
          <.icon name="hero-arrow-left-on-rectangle" class="size-3.5" />
          {gettext("Salir")}
        </button>
      </form>
    </div>
    {@inner_content}
  </body>
</html>
