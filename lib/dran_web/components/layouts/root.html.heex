<!DOCTYPE html>
<html lang={Gettext.get_locale(DranWeb.Gettext)} data-theme="dim">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Dran" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <div
      :if={assigns[:impersonator]}
      id="impersonation-banner"
      class="bg-warning text-warning-content px-4 py-2 flex flex-wrap items-center justify-center gap-3 text-sm"
    >
      <.icon name="hero-eye" class="size-4" />
      <span>
        {gettext("You are impersonating")} <strong>{assigns[:current_user]}</strong>
      </span>
      <form action={~p"/admin/impersonate"} method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <input type="hidden" name="_method" value="delete" />
        <button type="submit" class="btn btn-xs btn-neutral" id="stop-impersonating">
          {gettext("Stop impersonating")}
        </button>
      </form>
    </div>
    {@inner_content}
  </body>
</html>
