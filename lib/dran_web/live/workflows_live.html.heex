<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_user={@current_user}
  workspace_slug={@workspace_slug}
  workspaces={@workspaces}
  active_nav={@active_nav}
>
  <div class="p-6 w-full">
    <%= if @live_action == :index do %>
      <%!-- Header: title + toggle archivados + New — patrón pages --%>
      <div class="flex flex-wrap items-center justify-between gap-y-2 mb-4">
        <h1 class="text-2xl font-bold tracking-tight">{gettext("Workflows")}</h1>
        <div class="flex gap-2 shrink-0">
          <button
            :if={length(@archived_workflows) > 0}
            type="button"
            phx-click="toggle_archived"
            class={[
              "btn btn-ghost btn-sm",
              @show_archived && "btn-active border-primary/40"
            ]}
            data-testid="toggle-archived"
          >
            <.icon
              name={if @show_archived, do: "hero-document-text", else: "hero-archive-box"}
              class="w-4 h-4"
            />
            {if @show_archived,
              do: gettext("Workflows"),
              else: gettext("Archived")} ({if @show_archived,
              do: length(@workflows),
              else: length(@archived_workflows)})
          </button>
          <%!-- Filtros Kind/Estado alineados con el botón New Workflow --%>
          <div
            :if={not @show_archived}
            class="flex items-center gap-2 mr-2"
            data-testid="kind-filters"
          >
            <%!-- Kind filter dropdown (multi-select, URL state) --%>
            <div class="relative" id="kind-filter-root">
              <button
                type="button"
                phx-click="toggle_kind_menu"
                class={[
                  "inline-flex items-center gap-2 px-3 py-1.5 text-sm rounded-lg border transition-colors",
                  if(@kind_filters == [],
                    do: "border-base-300 text-base-content/70 hover:border-primary/40",
                    else: "border-primary bg-primary/10 text-primary font-medium"
                  )
                ]}
                data-testid="kind-filter-toggle"
              >
                <.icon name="hero-funnel" class="size-3.5" />
                {gettext("Kind")}
                <span
                  :if={@kind_filters != []}
                  class="px-1.5 py-0.5 text-[11px] font-semibold rounded-full bg-primary/15"
                >
                  {length(@kind_filters)}
                </span>
                <.icon
                  name={if @kind_menu_open, do: "hero-chevron-up", else: "hero-chevron-down"}
                  class="size-3.5 opacity-60"
                />
              </button>

              <div
                :if={@kind_menu_open}
                class="absolute z-20 mt-1.5 w-64 max-h-72 overflow-y-auto rounded-xl border border-base-300 bg-base-100 shadow-lg p-2"
                data-testid="kind-filter-menu"
              >
                <button
                  :for={kind <- @workflow_kinds}
                  type="button"
                  phx-click="toggle_kind"
                  phx-value-kind={kind}
                  class={[
                    "w-full flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-sm text-left transition-colors",
                    if(kind in @kind_filters,
                      do: "bg-primary/10 text-primary",
                      else: "hover:bg-base-200 text-base-content/80"
                    )
                  ]}
                  data-testid={"kind-option-" <> kind}
                >
                  <span class={[
                    "size-4 rounded border flex items-center justify-center shrink-0 transition-colors",
                    if(kind in @kind_filters,
                      do: "border-primary bg-primary text-primary-content",
                      else: "border-base-300"
                    )
                  ]}>
                    <.icon :if={kind in @kind_filters} name="hero-check" class="size-3" />
                  </span>
                  <span class="flex-1 truncate">{kind_label(kind)}</span>
                </button>

                <div class="border-t border-base-300 mt-1.5 pt-1.5">
                  <button
                    type="button"
                    phx-click="clear_filters"
                    class="w-full px-2.5 py-1.5 rounded-lg text-xs text-base-content/50 hover:text-error hover:bg-error/10 transition-colors text-left"
                    data-testid="kind-clear"
                  >
                    {gettext("Clear filters")}
                  </button>
                </div>
              </div>
            </div>

            <%!-- Status filter dropdown (multi-select, URL state) --%>
            <div class="relative" id="status-filter-root">
              <button
                type="button"
                phx-click="toggle_status_menu"
                class={[
                  "inline-flex items-center gap-2 px-3 py-1.5 text-sm rounded-lg border transition-colors",
                  if(@status_filters == [],
                    do: "border-base-300 text-base-content/70 hover:border-primary/40",
                    else: "border-primary bg-primary/10 text-primary font-medium"
                  )
                ]}
                data-testid="status-filter-toggle"
              >
                <.icon name="hero-adjustments-horizontal" class="size-3.5" />
                {gettext("Estado")}
                <span
                  :if={@status_filters != []}
                  class="px-1.5 py-0.5 text-[11px] font-semibold rounded-full bg-primary/15"
                >
                  {length(@status_filters)}
                </span>
                <.icon
                  name={if @status_menu_open, do: "hero-chevron-up", else: "hero-chevron-down"}
                  class="size-3.5 opacity-60"
                />
              </button>

              <div
                :if={@status_menu_open}
                class="absolute z-20 mt-1.5 w-56 max-h-72 overflow-y-auto rounded-xl border border-base-300 bg-base-100 shadow-lg p-2"
                data-testid="status-filter-menu"
              >
                <button
                  :for={status <- @status_options}
                  type="button"
                  phx-click="toggle_status"
                  phx-value-status={status}
                  class={[
                    "w-full flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-sm text-left transition-colors",
                    if(status in @status_filters,
                      do: "bg-primary/10 text-primary",
                      else: "hover:bg-base-200 text-base-content/80"
                    )
                  ]}
                  data-testid={"status-option-" <> status}
                >
                  <span class={[
                    "size-4 rounded border flex items-center justify-center shrink-0 transition-colors",
                    if(status in @status_filters,
                      do: "border-primary bg-primary text-primary-content",
                      else: "border-base-300"
                    )
                  ]}>
                    <.icon :if={status in @status_filters} name="hero-check" class="size-3" />
                  </span>
                  <span class="flex-1 truncate">{status_label(status)}</span>
                </button>

                <div class="border-t border-base-300 mt-1.5 pt-1.5">
                  <button
                    type="button"
                    phx-click="clear_filters"
                    class="w-full px-2.5 py-1.5 rounded-lg text-xs text-base-content/50 hover:text-error hover:bg-error/10 transition-colors text-left"
                    data-testid="status-clear"
                  >
                    {gettext("Clear filters")}
                  </button>
                </div>
              </div>
            </div>
          </div>
          <.link
            patch={filters_path(@workspace_slug, @kind_filters, @status_filters, "?new=true")}
            class="btn btn-primary btn-sm"
            data-testid="new-workflow-button"
          >
            <.icon name="hero-plus" class="w-4 h-4" /> {gettext("New Workflow")}
          </.link>
        </div>
      </div>

      <%= if @show_archived do %>
        <%!-- Switch ON: archivados — patrón pages --%>
        <div
          class="rounded-xl border border-base-300 bg-base-200/30"
          data-testid="archived-section"
        >
          <div class="flex items-center justify-between px-4 py-3 border-b border-base-300">
            <div class="flex items-center gap-2 text-sm font-semibold text-base-content/60">
              <.icon name="hero-archive-box" class="size-4" />
              {gettext("Archived")}
              <span class="px-1.5 py-0.5 text-xs rounded-md bg-base-300 text-base-content/60">
                {length(@archived_workflows)}
              </span>
            </div>
          </div>
          <div class="px-4 py-2 space-y-1">
            <%= for item <- Enum.take(@archived_workflows, @archived_visible_count) do %>
              <% wf = item.workflow %>
              <div
                class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-base-200 transition-colors opacity-70 hover:opacity-100"
                data-testid={"archived-workflow-" <> wf.slug}
              >
                <.icon name="hero-bolt" class="size-4 text-base-content/40 shrink-0" />
                <.link
                  navigate={~p"/#{@context.slug}/workflows/#{wf.slug}"}
                  class="text-sm flex-1 truncate hover:text-primary transition-colors"
                >
                  {wf.title}
                </.link>
                <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-base-300 text-base-content/50">
                  {kind_label(wf.kind)}
                </span>
                <span :if={wf.updated_at} class="text-caption shrink-0">
                  {Calendar.strftime(wf.updated_at, "%b %d")}
                </span>
                <button
                  type="button"
                  phx-click="unarchive_workflow"
                  phx-value-workflow-id={wf.id}
                  title={gettext("Unarchive")}
                  class="p-1 rounded-lg text-base-content/40 hover:text-success hover:bg-success/10 transition-colors shrink-0"
                  data-testid={"unarchive-btn-" <> wf.slug}
                >
                  <.icon name="hero-arrow-up-on-square" class="size-4" />
                </button>
              </div>
            <% end %>
            <p
              :if={@archived_workflows == []}
              class="text-xs text-base-content/30 text-center py-2"
            >
              {gettext("No archived workflows")}
            </p>
            <button
              :if={length(@archived_workflows) > @archived_visible_count}
              type="button"
              phx-click="load_more_archived"
              class="w-full mt-1 py-2 rounded-lg border border-dashed border-base-300 text-sm text-base-content/50 hover:text-primary hover:border-primary/40 transition-colors"
              data-testid="load-more-archived"
            >
              {gettext("Load more")} ({length(@archived_workflows) - @archived_visible_count})
            </button>
          </div>
        </div>
      <% else %>
        <%!-- Switch OFF: workflows activos — cards --%>
        <div class="grid gap-4 md:grid-cols-2">
          <%= for item <- Enum.take(@workflows, @visible_count) do %>
            <% wf = item.workflow %>
            <div
              id={"workflow-card-#{wf.id}"}
              class="rounded-2xl bg-base-100 border border-base-300 p-4 flex flex-col gap-2 transition hover:border-primary/40"
            >
              <div class="flex items-center justify-between gap-2">
                <div class="min-w-0 flex-1">
                  <.link
                    navigate={~p"/#{@context.slug}/workflows/#{wf.slug}"}
                    class="text-sm font-semibold truncate hover:underline"
                  >
                    {wf.title}
                  </.link>
                  <p class="text-xs text-base-content/50">
                    {item.steps_count} {gettext("steps")}
                  </p>
                </div>
                <div class="flex flex-wrap gap-1 shrink-0">
                  <span class={["badge badge-sm", workflow_chip(wf.status)]}>
                    {status_label(wf.status)}
                  </span>
                  <span class="badge badge-ghost badge-sm">{kind_label(wf.kind)}</span>
                </div>
              </div>

              <%!-- In-flight sessions on the index card --%>
              <div :if={item.active_sessions != []} class="space-y-1.5">
                <%= for {session, progress} <- item.active_sessions do %>
                  <div class="space-y-1">
                    <div class="flex items-center gap-2 text-xs">
                      <span class={["badge badge-xs", session_chip(session.status)]}>
                        {status_label(session.status)}
                      </span>
                      <span class="truncate flex-1 text-base-content/60">
                        {session.label || gettext("Sesión")}
                      </span>
                      <span class="shrink-0 font-mono">{progress_label(progress)}</span>
                      <button
                        type="button"
                        phx-click="abort_session"
                        phx-value-session-id={session.id}
                        class="btn btn-xs btn-ghost text-error shrink-0"
                      >
                        {gettext("Abortar")}
                      </button>
                    </div>
                    <progress
                      class="progress progress-primary w-full"
                      value={session_pct(progress)}
                      max="100"
                    ></progress>
                  </div>
                <% end %>
              </div>

              <%!-- Nueva sesión + Archive --%>
              <div class="flex items-center gap-2 mt-1">
                <.form
                  :if={wf.status != "archived"}
                  id={"workflow-session-form-#{wf.id}"}
                  for={%{}}
                  phx-submit="open_session"
                  phx-value-workflow-id={wf.id}
                  class="flex-1 min-w-0"
                >
                  <button type="submit" class="btn btn-primary btn-sm w-full">
                    <.icon name="hero-play" class="size-3.5" /> {gettext("Nueva sesión")}
                  </button>
                </.form>
                <button
                  type="button"
                  phx-click="archive_workflow"
                  phx-value-workflow-id={wf.id}
                  title={gettext("Archive")}
                  class="p-1.5 rounded-lg text-base-content/40 hover:text-warning hover:bg-warning/10 transition-colors shrink-0"
                  data-testid={"archive-btn-" <> wf.slug}
                >
                  <.icon name="hero-archive-box" class="size-4" />
                </button>
              </div>
            </div>
          <% end %>
        </div>

        <button
          :if={length(@workflows) > @visible_count}
          type="button"
          phx-click="load_more"
          class="w-full mt-4 py-2 rounded-lg border border-dashed border-base-300 text-sm text-base-content/50 hover:text-primary hover:border-primary/40 transition-colors"
          data-testid="load-more"
        >
          {gettext("Load more")} ({length(@workflows) - @visible_count})
        </button>

        <p :if={@workflows == []} class="text-sm text-base-content/40 py-8 text-center">
          {gettext("No hay workflows todavía.")}
        </p>
      <% end %>
    <% else %>
      <%!-- Show: steps DAG + sessions + runs --%>
      <div class="flex items-center gap-3 mb-4">
        <.link
          patch={filters_path(@workspace_slug, @kind_filters, @status_filters)}
          class="text-sm text-base-content/50 hover:text-base-content"
        >
          ← {gettext("Workflows")}
        </.link>
        <h2 class="text-xl font-bold tracking-tight truncate">{@workflow.title}</h2>
        <span class={["badge badge-sm", workflow_chip(@workflow.status)]}>
          {status_label(@workflow.status)}
        </span>
        <span class="badge badge-ghost badge-sm">{kind_label(@workflow.kind)}</span>
        <div class="ml-auto flex gap-1 shrink-0">
          <button
            type="button"
            phx-click="open_workflow_edit"
            class="btn btn-ghost btn-xs text-base-content/50 hover:text-primary"
            title={gettext("Editar")}
            data-testid="edit-workflow-btn"
          >
            <.icon name="hero-pencil-square" class="size-3.5" />
          </button>
          <button
            :if={@workflow.status != "archived"}
            type="button"
            phx-click="archive_workflow"
            phx-value-workflow-id={@workflow.id}
            class="btn btn-ghost btn-xs text-base-content/50 hover:text-warning"
            title={gettext("Archive")}
          >
            <.icon name="hero-archive-box" class="size-3.5" />
          </button>
          <button
            :if={@workflow.status == "archived"}
            type="button"
            phx-click="unarchive_workflow"
            phx-value-workflow-id={@workflow.id}
            class="btn btn-ghost btn-xs text-base-content/50 hover:text-success"
          >
            <.icon name="hero-arrow-up-on-square" class="size-3.5" /> {gettext("Restaurar")}
          </button>
        </div>
      </div>

      <div class="grid gap-4 lg:grid-cols-3">
        <div class="lg:col-span-2 space-y-4">
          <%!-- DAG of steps (topological columns) --%>
          <div
            id="wfe-canvas"
            phx-hook="WfCanvas"
            class="relative rounded-2xl bg-base-200/40 border border-base-300 overflow-hidden select-none h-[480px] max-h-[64vh]"
          >
            <div
              data-wf-stage
              class="absolute top-0 left-0 will-change-transform"
              style="transform-origin: 0 0"
            >
              <% graph_nodes = graph_nodes(@steps, @positions) %>
              <% edges = graph_edges(@edges, @positions, @passed_step_ids) %>
              <% graph_ports = graph_ports(edges, @positions) %>
              <div
                class="relative"
                style={"width: #{graph_width(@positions)}px; height: #{graph_height(@positions)}px"}
              >
                <%!-- Aristas (SVG) — flecha de dirección al final (mismo
                     marker que el mini-canvas del step editor) --%>
                <svg
                  class="absolute inset-0 pointer-events-none"
                  style={"width: #{graph_width(@positions)}px; height: #{graph_height(@positions)}px"}
                  viewBox={"0 0 #{graph_width(@positions)} #{graph_height(@positions)}"}
                  fill="none"
                >
                  <defs>
                    <marker
                      id="wfe-arrow"
                      viewBox="0 0 10 7"
                      refX="9"
                      refY="3.5"
                      markerWidth="8"
                      markerHeight="6"
                      orient="auto"
                    >
                      <path
                        d="M 0 0 L 10 3.5 L 0 7 Z"
                        fill="oklch(from var(--color-base-content) l c h / 45%)"
                      />
                    </marker>
                    <marker
                      id="wfe-arrow-done"
                      viewBox="0 0 10 7"
                      refX="9"
                      refY="3.5"
                      markerWidth="8"
                      markerHeight="6"
                      orient="auto"
                    >
                      <path d="M 0 0 L 10 3.5 L 0 7 Z" fill="var(--color-success)" />
                    </marker>
                  </defs>
                  <%= for {_src_id, edge} <- edges do %>
                    <path
                      d={edge.path}
                      data-edge-key={edge.prereq_id <> "|" <> edge.dependent_id}
                      marker-end="url(#wfe-arrow)"
                      class={[
                        "wfe-edge",
                        edge.done && "wfe-edge-done",
                        !edge.done && "wfe-edge-pending"
                      ]}
                    />
                  <% end %>
                </svg>

                <%!-- Menú de arista (⋯ en el punto medio, HTML overlay — SVG
                     no renderiza HTML): agregar step nuevo en medio, linkear
                     un step existente, romper conexión. El toggle y el modo
                     "linkear" viven en el hook WfCanvas; las acciones son
                     eventos del LV. --%>
                <div class="absolute inset-0 pointer-events-none">
                  <%= for {_src_id, edge} <- edges do %>
                    <div
                      data-wf-edge-menu
                      data-edge-key={edge.prereq_id <> "|" <> edge.dependent_id}
                      data-prereq-id={edge.prereq_id}
                      data-dependent-id={edge.dependent_id}
                      class="wfe-edge-menu"
                      style={
                        "left: #{(edge.x1 + edge.x2) / 2 - 10}px; top: #{(edge.y1 + edge.y2) / 2 - 10}px"
                      }
                    >
                      <button
                        type="button"
                        data-edge-menu-toggle
                        title={gettext("Opciones de la conexión")}
                        aria-label={gettext("Opciones de la conexión")}
                        class="wfe-edge-menu-btn"
                      >
                        <.icon name="hero-ellipsis-horizontal" class="size-3.5" />
                      </button>

                      <div class="wfe-edge-menu-pop" role="menu">
                        <button
                          type="button"
                          phx-click="edge_add_step"
                          phx-value-prereq-id={edge.prereq_id}
                          phx-value-dependent-id={edge.dependent_id}
                          class="wfe-edge-menu-item"
                          data-testid="edge-add-new"
                        >
                          <.icon name="hero-plus" class="size-3.5 shrink-0" />
                          {gettext("Agregar step")}
                        </button>
                        <button
                          type="button"
                          data-edge-menu-link
                          phx-value-prereq-id={edge.prereq_id}
                          phx-value-dependent-id={edge.dependent_id}
                          class="wfe-edge-menu-item"
                          data-testid="edge-link-existing"
                        >
                          <.icon name="hero-link" class="size-3.5 shrink-0" />
                          {gettext("Linkear step…")}
                        </button>
                        <button
                          type="button"
                          phx-click="remove_dependency"
                          phx-value-prereq-id={edge.prereq_id}
                          phx-value-dependent-id={edge.dependent_id}
                          class="wfe-edge-menu-item wfe-edge-menu-danger"
                          data-testid="edge-remove"
                        >
                          <.icon name="hero-scissors" class="size-3.5 shrink-0" />
                          {gettext("Romper conexión")}
                        </button>
                      </div>

                      <%!-- Picker de step existente (modo "linkear"): llenado
                           y mostrado por el hook WfCanvas; el click en una
                           opción dispara "link_step_between". --%>
                      <div class="wfe-edge-picker" data-edge-picker></div>
                    </div>
                  <% end %>
                </div>

                <%!-- Nodos (HTML cards) — arrastrables; el lápiz abre la
                     edición (decisión de Álvaro: no click-en-toda-la-card) --%>
                <%= for {step, x, y} <- graph_nodes do %>
                  <div
                    class={[
                      "wfe-node group absolute rounded-xl bg-base-100 border border-base-300 p-3 shadow-sm transition-all duration-300",
                      "cursor-grab hover:border-primary/50 hover:shadow active:cursor-grabbing",
                      step_has_passed?(@passed_step_ids, step.id) && "border-success/60"
                    ]}
                    style={"left: #{x}px; top: #{y}px; width: #{node_w()}px"}
                    data-step-id={step.id}
                    data-testid="step-node"
                  >
                    <div class="flex items-center gap-1.5 text-xs text-base-content/50">
                      <span
                        :if={Contracts.contract?(step)}
                        class="badge badge-ghost badge-xs"
                      >
                        contract
                      </span>
                      <span class="ml-auto font-mono">
                        #{step.position}
                      </span>
                      <button
                        type="button"
                        phx-click="open_step_modal"
                        phx-value-mode="edit"
                        phx-value-step-id={step.id}
                        data-wf-no-drag
                        data-testid="step-edit"
                        title={gettext("Edit step")}
                        aria-label={gettext("Edit step")}
                        class="shrink-0 size-5 flex items-center justify-center rounded-md text-base-content/35 transition-colors duration-150 hover:text-primary hover:bg-base-200 focus-visible:text-primary"
                      >
                        <.icon name="hero-pencil" class="size-3.5" />
                      </button>
                    </div>
                    <p data-step-title class="text-sm font-medium mt-1 leading-snug line-clamp-2">
                      {step.title}
                    </p>
                  </div>
                <% end %>

                <%!-- Port dots — siempre presentes; drop targets de conexiones --%>
                <%= for {step, x, y} <- graph_nodes do %>
                  <% port = Map.get(graph_ports, step.id) %>
                  <span
                    data-wf-port="in"
                    data-step-id={step.id}
                    data-testid="port-in"
                    class={[
                      "absolute w-3 h-3 rounded-full border-2 border-base-100 cursor-crosshair",
                      port && port.in && port.in.done && "wfe-port-done"
                    ]}
                    style={
                      "left: #{x - 6}px; top: #{y + node_h() / 2 - 6}px; background: var(--color-info);"
                    }
                  />
                  <span
                    data-wf-port="out"
                    data-step-id={step.id}
                    data-testid="port-out"
                    class={[
                      "absolute w-3 h-3 rounded-full border-2 border-base-100 cursor-crosshair",
                      port && port.out && port.out.done && "wfe-port-done"
                    ]}
                    style={
                      "left: #{x + node_w() - 6}px; top: #{y + node_h() / 2 - 6}px; background: var(--color-primary);"
                    }
                  />
                <% end %>
              </div>
            </div>

            <%!-- Zoom controls --%>
            <div
              data-wf-controls
              class="absolute bottom-3 right-3 flex items-center gap-1 rounded-lg bg-base-100 border border-base-300 shadow-sm p-1 z-10"
            >
              <button
                type="button"
                data-wf-zoom="out"
                aria-label="Zoom out"
                class="w-7 h-7 flex items-center justify-center rounded-md hover:bg-base-200 text-base-content/70"
              >
                −
              </button>
              <button
                type="button"
                data-wf-fit
                aria-label="Fit graph"
                class="w-7 h-7 flex items-center justify-center rounded-md hover:bg-base-200 text-base-content/70"
              >
                ⤢
              </button>
              <button
                type="button"
                data-wf-zoom="in"
                aria-label="Zoom in"
                class="w-7 h-7 flex items-center justify-center rounded-md hover:bg-base-200 text-base-content/70"
              >
                +
              </button>
              <span class="w-px h-5 bg-base-300"></span>
              <button
                type="button"
                phx-click="repack_layout"
                aria-label="Ordenar por nivel"
                title={gettext("Ordenar por nivel")}
                class="w-7 h-7 flex items-center justify-center rounded-md hover:bg-base-200 text-base-content/70"
              >
                <.icon name="hero-square-3-stack-3d" class="size-4" />
              </button>
            </div>

            <%!-- Agregar step nuevo: overlay dentro del canvas, mismo patrón que
                 el botón "+ Nodo" del mini-canvas de steps. phx-click = WfPanZoom
                 ignora para pan; data-wf-controls = dblclick ignora. --%>
            <button
              :if={@workflow.status != "archived"}
              type="button"
              data-wf-controls
              phx-click="open_step_modal"
              phx-value-mode="new"
              title={gettext("Agregar paso al workflow")}
              class="absolute top-3 right-3 z-20 inline-flex items-center gap-1 rounded-lg border border-base-300 bg-base-100 px-2 py-1 text-xs font-medium text-base-content/70 shadow-sm transition-colors duration-150 hover:bg-base-200 hover:text-base-content"
            >
              <.icon name="hero-plus" class="size-3.5" /> {gettext("Step")}
            </button>

            <p
              :if={@steps == []}
              class="absolute inset-0 flex items-center justify-center text-sm text-base-content/40"
            >
              {gettext("El workflow no tiene steps.")}
            </p>
          </div>

          <%!-- Ready / blocked panels (definition layer) --%>
          <div class="grid gap-4 md:grid-cols-2">
            <div class="rounded-2xl bg-base-100 border border-base-300 p-4">
              <h3 class="text-xs uppercase tracking-wider text-info mb-2">
                {gettext("Listos (sin prereqs)")}
              </h3>
              <div class="space-y-2">
                <p :for={step <- ready_steps(@steps, @dep_info)} class="text-sm font-medium">
                  {step.title}
                </p>
                <p
                  :if={ready_steps(@steps, @dep_info) == []}
                  class="text-xs text-base-content/40"
                >
                  {gettext("Nada listo.")}
                </p>
              </div>
              <p class="text-xs text-base-content/40 mt-3">
                {gettext("La ejecución real es por sesión: mira los prereqs de cada run abajo.")}
              </p>
            </div>

            <div class="rounded-2xl bg-base-100 border border-base-300 p-4">
              <h3 class="text-xs uppercase tracking-wider text-warning mb-2">
                {gettext("Bloqueados (definición)")}
              </h3>
              <div class="space-y-2">
                <p
                  :for={step <- blocked_steps(@steps, @dep_info)}
                  class="text-sm"
                >
                  <span class="font-medium">{step.title}</span>
                  <span class="text-xs text-base-content/40">
                    · {gettext("espera %{count} dep(s)", count: blocked_count(step, assigns))}
                  </span>
                </p>
                <p
                  :if={blocked_steps(@steps, @dep_info) == []}
                  class="text-xs text-base-content/40"
                >
                  {gettext("Nada bloqueado.")}
                </p>
              </div>
            </div>
          </div>
        </div>

        <%!-- Sessions + runs panel --%>
        <div class="space-y-4">
          <div class="rounded-2xl bg-base-100 border border-base-300 p-4">
            <h3 class="text-xs uppercase tracking-wider text-base-content/50 mb-2">
              {gettext("Sesiones")}
            </h3>

            <.form
              :if={@workflow.status != "archived"}
              id="workflow-session-form"
              for={%{}}
              phx-submit="open_session"
              phx-value-workflow-id={@workflow.id}
              class="mb-3"
            >
              <button type="submit" class="btn btn-primary btn-sm w-full">
                <.icon name="hero-play" class="size-3.5" /> {gettext("Nueva sesión")}
              </button>
            </.form>

            <div class="space-y-2">
              <%= for {session, progress} <- @sessions do %>
                <div
                  id={"session-row-#{session.id}"}
                  class={[
                    "rounded-xl border p-2.5 cursor-pointer transition",
                    @selected_session && @selected_session.id == session.id &&
                      "border-primary bg-primary/5",
                    (!@selected_session || @selected_session.id != session.id) &&
                      "border-base-300 hover:border-primary/40"
                  ]}
                  phx-click="select_session"
                  phx-value-session-id={session.id}
                >
                  <div class="flex items-center gap-2">
                    <span class={["badge badge-sm", session_chip(session.status)]}>
                      {status_label(session.status)}
                    </span>
                    <span class="text-sm font-medium truncate flex-1">
                      {session.label || gettext("Sesión")}
                    </span>
                    <button
                      :if={session.status == "in_flight"}
                      type="button"
                      phx-click="abort_session"
                      phx-value-session-id={session.id}
                      class="btn btn-xs btn-ghost text-error shrink-0"
                    >
                      {gettext("Abortar")}
                    </button>
                    <button
                      :if={session.status != "in_flight"}
                      type="button"
                      phx-click="delete_session"
                      phx-value-session-id={session.id}
                      data-confirm={
                        gettext(
                          "¿Eliminar esta sesión? Borra también sus runs. Historia irrecuperable."
                        )
                      }
                      class="p-1 rounded-lg text-base-content/40 hover:text-error hover:bg-error/10 transition-colors shrink-0"
                      title={gettext("Eliminar sesión")}
                      data-testid={"delete-session-#{session.id}"}
                    >
                      <.icon name="hero-trash" class="size-3.5" />
                    </button>
                  </div>
                  <div class="flex items-center gap-2 mt-1.5">
                    <progress
                      class="progress progress-primary flex-1"
                      value={session_pct(progress)}
                      max="100"
                    ></progress>
                    <span class="text-xs font-mono text-base-content/50 shrink-0">
                      {progress_label(progress)}
                    </span>
                  </div>
                  <p class="text-xs text-base-content/40 mt-1">
                    {format_dt(session.started_at)}
                    <%= if session.finished_at do %>
                      → {format_dt(session.finished_at)}
                    <% end %>
                  </p>
                </div>
              <% end %>
              <p :if={@sessions == []} class="text-xs text-base-content/40">
                {gettext("Sin sesiones todavía.")}
              </p>
            </div>
          </div>

          <%!-- Runs of the selected session --%>
          <div class="rounded-2xl bg-base-100 border border-base-300 p-4">
            <h3 class="text-xs uppercase tracking-wider text-base-content/50 mb-2">
              {gettext("Runs")}
              <span :if={@selected_session} class="badge badge-ghost badge-sm ml-1">
                {@selected_session.label || gettext("Sesión")}
              </span>
            </h3>

            <div class="space-y-1.5">
              <%= for rv <- @run_views do %>
                <div
                  id={"run-row-#{rv.run.id}"}
                  class="flex items-center gap-2 text-sm"
                >
                  <span class={["badge badge-sm shrink-0", run_chip(rv.run.status)]}>
                    {status_label(rv.run.status)}
                  </span>
                  <span class="flex-1 min-w-0 truncate">{rv.title}</span>
                  <span :if={rv.run.attempt > 1} class="text-xs text-base-content/40 shrink-0">
                    ×{rv.run.attempt}
                  </span>
                  <span
                    :if={phase = run_phase(rv.run)}
                    class="badge badge-ghost badge-xs shrink-0"
                  >
                    {phase}
                  </span>
                </div>
              <% end %>
              <p :if={@run_views == []} class="text-xs text-base-content/40">
                {gettext("Selecciona una sesión para ver sus runs.")}
              </p>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%!-- Create-workflow modal (?new=true) — pages/goals resource pattern --%>
  <.resource_modal
    :if={@modal_open}
    id="workflow-resource-modal"
    title={gettext("New Workflow")}
    pill="WORKFLOW"
    pill_class="bg-primary/10 text-primary"
    on_close="close_workflow_modal"
    form_id="workflow-modal-form"
    submit_label={gettext("Create Workflow")}
  >
    <div class="flex items-center justify-between mb-4">
      <p class="text-sm text-base-content/60">
        {gettext("Define the plan, its kind and who it runs for.")}
      </p>
      <.link
        navigate={~p"/#{@workspace_slug}/docs"}
        class="text-xs text-base-content/50 hover:text-primary"
      >
        {gettext("Docs de workflows →")}
      </.link>
    </div>

    <%!-- One `<.form>` spans BOTH columns — a single submit carries
         everything (task/goal modal pattern). --%>
    <.form
      id="workflow-modal-form"
      for={@form}
      phx-change="validate_workflow"
      phx-submit="save_workflow"
      class="grid grid-cols-1 lg:grid-cols-[1fr_20rem] lg:gap-6"
    >
      <div class="min-w-0 space-y-4">
        <.input
          field={@form[:title]}
          type="text"
          label={gettext("Title")}
          placeholder={gettext("Workflow title…")}
          class="text-lg font-medium"
          autofocus
        />

        <div>
          <span class="label mb-1 block text-xs text-base-content/60">{gettext("Content")}</span>
          <.markdown_editor
            id="workflow-editor-modal-new"
            body=""
            workspace_id={@context && @context.id}
            autosave={false}
            toolbar={false}
            hidden_field="workflow[body]"
            min_height="240px"
          />
        </div>
      </div>

      <aside class="space-y-4 lg:border-l lg:border-base-300 lg:pl-6">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
          {gettext("Details")}
        </h4>

        <.resource_select name="workflow[kind]" label={gettext("Kind")}>
          <option value="evergreen" selected={input_value(@form, :kind) not in ["one_shot"]}>
            {gettext("Evergreen")} — {gettext("re-runnable, N sesiones")}
          </option>
          <option value="one_shot" selected={input_value(@form, :kind) == "one_shot"}>
            {gettext("One shot")} — {gettext("single pass")}
          </option>
        </.resource_select>

        <.resource_select name="workflow[status]" label={gettext("Status")}>
          <option value="draft" selected={input_value(@form, :status) == "draft"}>
            {gettext("Draft")}
          </option>
          <option value="active" selected={input_value(@form, :status) in [nil, "active"]}>
            {gettext("Active")}
          </option>
        </.resource_select>

        <.resource_select name="workflow[goal_id]" label={gettext("Goal")}>
          <option value="" selected={is_nil(input_value(@form, :goal_id))}>
            {gettext("no goal")}
          </option>
          <.goal_options tree={@goal_tree} selected_id={input_value(@form, :goal_id)} />
        </.resource_select>
      </aside>
    </.form>
  </.resource_modal>

  <%!-- Edit-workflow modal (show, ?edit=true) — kind is a PRE-execution
       decision: the select renders disabled once the workflow has sessions
       (the context refuses the change with :kind_locked anyway). --%>
  <.resource_modal
    :if={@wf_edit}
    id="workflow-edit-modal"
    title={gettext("Edit Workflow")}
    pill="WORKFLOW"
    pill_class="bg-primary/10 text-primary"
    on_close="close_workflow_edit"
    form_id="workflow-edit-form"
    submit_label={gettext("Save Workflow")}
  >
    <p class="text-sm text-base-content/60">
      {gettext("Nombre y estado del workflow.")}
      <%= if @wf_edit.kind_locked do %>
        <span class="block mt-1 text-warning">
          {gettext("El kind quedó bloqueado: este workflow ya tiene sesiones.")}
        </span>
      <% end %>
    </p>

    <.form
      id="workflow-edit-form"
      for={@wf_edit.form}
      phx-change="validate_workflow_edit"
      phx-submit="save_workflow_edit"
      class="space-y-4"
    >
      <.input
        field={@wf_edit.form[:title]}
        type="text"
        label={gettext("Title")}
        class="text-lg font-medium"
        autofocus
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <.input
          field={@wf_edit.form[:kind]}
          type="select"
          label={gettext("Kind")}
          options={[
            {gettext("Evergreen"), "evergreen"},
            {gettext("One shot"), "one_shot"}
          ]}
          disabled={@wf_edit.kind_locked}
          data-testid="edit-kind-select"
        />

        <.input
          field={@wf_edit.form[:status]}
          type="select"
          label={gettext("Status")}
          options={[
            {gettext("Draft"), "draft"},
            {gettext("Active"), "active"}
          ]}
        />
      </div>
    </.form>
  </.resource_modal>

  <%!-- Step create/edit modal (show) — ?new_step=true / ?step=<id> --%>
  <.resource_modal
    :if={@step_modal}
    id="step-resource-modal"
    title={
      if @step_modal.mode == :new,
        do: gettext("New Step"),
        else: gettext("Edit Step")
    }
    pill="STEP"
    pill_class="bg-primary/10 text-primary"
    on_close="close_step_modal"
    form_id="step-modal-form"
    submit_label={
      if @step_modal.mode == :new,
        do: gettext("Create Step"),
        else: gettext("Save Step")
    }
  >
    <p class="text-sm text-base-content/60">
      {gettext("What this step achieves (intent), its contract, and the context the agent reads.")}
    </p>

    <%!-- One `<.form>` spans BOTH columns — a single submit carries
         everything (task/goal modal pattern). Main column: client-side
         tabs (Intent / Claims / Gates / Grafo / Contexto) + visual
         contract editor (`StepEditorComponents`). Sidebar: Details /
         Conexiones. --%>
    <.form
      id="step-modal-form"
      for={@step_form}
      phx-change="validate_step"
      phx-submit="save_step"
      class="grid grid-cols-1 lg:grid-cols-[1fr_20rem] lg:gap-6"
    >
      <.step_editor_tabs
        id={"step-editor-tabs-#{if @step_modal.step && @step_modal.step.id, do: @step_modal.step.id, else: "new"}"}
        form={@step_form}
        step={@step_modal.step}
      />

      <aside class="space-y-4 lg:border-l lg:border-base-300 lg:pl-6">
        <%!-- Lint del contrato arriba del sidebar (antes vivía al pie del editor
             de la columna principal). --%>
        <.contract_lint_feedback lint={@contract_lint} />

        <h4 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
          {gettext("Details")}
        </h4>

        <%!-- Status del contrato: columna server-side (ya no viaja en el JSON
             del contrato que serializa el hook). --%>
        <.input
          field={@step_form[:status]}
          type="select"
          label={gettext("Status")}
          options={[
            {gettext("Draft"), "draft"},
            {gettext("Active"), "active"},
            {gettext("Superseded"), "superseded"}
          ]}
        />

        <%!-- Create only: place the new step behind an existing one
             (depends_on edge to the chosen step). --%>
        <label
          :if={@step_modal.mode == :new and @step_modal.after_step_id}
          class="flex items-center gap-2 cursor-pointer"
        >
          <input
            type="checkbox"
            name="new_step[after]"
            value={@step_modal.after_step_id}
            class="checkbox checkbox-sm checkbox-primary"
          />
          <span class="text-sm">
            {gettext("Después de")}
            <span class="font-medium">
              {step_title(@steps_by_id, @step_modal.after_step_id)}
            </span>
          </span>
        </label>

        <p class="text-xs text-base-content/40">
          {gettext("Unique per workspace. Empty = derived from the title.")}
        </p>

        <%!-- Conexiones del step (edit): romper aristas exists-on. Alta de
             conexiones sigue siendo del canvas (puerto→puerto / menú de
             arista) — decisión de producto. --%>
        <div
          :if={@step_modal.mode == :edit}
          class="space-y-2"
          data-testid="step-connections"
        >
          <h4 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
            {gettext("Conexiones")}
          </h4>

          <p class="text-xs text-base-content/40">
            {gettext("Dependencias directas del paso. Romper una conexión no borra steps.")}
          </p>

          <div :if={@outgoing_deps != []} class="space-y-1">
            <p class="text-xs text-base-content/40">
              {gettext("Depende de")}
            </p>
            <ul class="space-y-1">
              <li :for={pre <- @outgoing_deps} class="flex items-center gap-1.5 text-sm">
                <.icon name="hero-arrow-down-left" class="size-3.5 text-base-content/40 shrink-0" />
                <span class="truncate flex-1" title={pre.title}>{pre.title}</span>
                <button
                  type="button"
                  phx-click="remove_step_dependency"
                  phx-value-step-id={@step_modal.step.id}
                  phx-value-other-id={pre.id}
                  data-confirm={gettext("¿Romper la conexión con este paso?")}
                  title={gettext("Romper conexión")}
                  class="shrink-0 size-5 flex items-center justify-center rounded-md text-base-content/35 transition-colors duration-150 hover:text-error hover:bg-base-200"
                  data-testid={"unlink-out-#{pre.id}"}
                >
                  <.icon name="hero-scissors" class="size-3.5" />
                </button>
              </li>
            </ul>
          </div>

          <div :if={@incoming_deps != []} class="space-y-1">
            <p class="text-xs text-base-content/40">
              {gettext("Requerido por")}
            </p>
            <ul class="space-y-1">
              <li :for={dep <- @incoming_deps} class="flex items-center gap-1.5 text-sm">
                <.icon name="hero-arrow-up-right" class="size-3.5 text-base-content/40 shrink-0" />
                <span class="truncate flex-1" title={dep.title}>{dep.title}</span>
                <button
                  type="button"
                  phx-click="remove_step_dependency"
                  phx-value-step-id={@step_modal.step.id}
                  phx-value-other-id={dep.id}
                  data-confirm={gettext("¿Romper la conexión con este paso?")}
                  title={gettext("Romper conexión")}
                  class="shrink-0 size-5 flex items-center justify-center rounded-md text-base-content/35 transition-colors duration-150 hover:text-error hover:bg-base-200"
                  data-testid={"unlink-in-#{dep.id}"}
                >
                  <.icon name="hero-scissors" class="size-3.5" />
                </button>
              </li>
            </ul>
          </div>

          <p
            :if={@outgoing_deps == [] and @incoming_deps == []}
            class="text-xs text-base-content/40"
            data-testid="step-connections-empty"
          >
            {gettext("Sin conexiones. Conecta steps arrastrando entre puertos en el canvas.")}
          </p>
        </div>

        <p class="text-xs text-base-content/40">
          {gettext(
            "La ejecución NO sigue position: la secuencia la definen las aristas depends_on entre steps (steps sin prereqs corren en paralelo)."
          )}
        </p>

        <%!-- meta (incl. contract) y position no se editan aquí: el modal no
             los envía, update los conserva tal cual. El contrato se edita en
             la pestaña Contrato de la columna principal (StepEditorComponents)
             — mismo canal step[contract_json], mismo lint en vivo. --%>
      </aside>
    </.form>

    <%!-- Destructive: delete with domain guards (has_open_runs /
         referenced_by_open_session). The modal covers the page flash
         group, so guard errors render here, inside the footer. --%>
    <:left>
      <p
        :if={@step_delete_error}
        class="text-sm text-error flex items-center gap-1.5"
        data-testid="step-delete-error"
      >
        <.icon name="hero-exclamation-circle" class="size-4 shrink-0" /> {@step_delete_error}
      </p>
      <button
        :if={@step_modal.mode == :edit}
        type="button"
        phx-click="delete_step"
        phx-value-step-id={@step_modal.step.id}
        data-confirm={
          gettext("¿Eliminar este step? Borra también sus runs de sesiones cerradas.")
        }
        class="btn btn-ghost btn-sm text-error"
        data-testid="delete-step"
      >
        <.icon name="hero-trash" class="size-4" /> {gettext("Delete")}
      </button>
    </:left>
  </.resource_modal>
</Layouts.app>
